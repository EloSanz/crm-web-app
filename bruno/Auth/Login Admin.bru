meta {
  name: Login Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@crm.com",
    "password": "admin123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("authToken", res.body.access_token);
  }
}
