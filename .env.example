# ==============================================================================
# SISTEMA CRM PARA GESTIÓN COMERCIAL (UNLaM GADS II - Corralón de Materiales)
# Archivo de configuración de variables de entorno de ejemplo (.env.example)
# ==============================================================================

# Backend Settings (FastAPI)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
APP_NAME=CRM Web App
APP_VERSION=0.1.0

# Base de Datos & Autenticación (Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Seguridad & Sesión (JWT & Clave de API)
JWT_SECRET_KEY=dev-jwt-secret-key-for-local-testing-only-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CRM_API_KEY=crm_live_corralon_secret_key_2026

# Frontend Settings (Next.js 16)
# Dejar NEXT_PUBLIC_API_URL vacío en producción para same-origin /api/* o configurar URL en desarrollo local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CRM_API_KEY=crm_live_corralon_secret_key_2026
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key


# AWS S3 Storage (Imágenes de materiales, remitos y fotos de obras)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=myawsbucketelito
AWS_S3_CUSTOM_DOMAIN=


# ------------------------------------------------------------------------------
# Correo (envío de correos al cliente desde el presupuesto)
# ------------------------------------------------------------------------------
# Proveedor: "log" (por defecto: no envía nada y el correo queda como simulado; ideal para desarrollo),
# "resend" (API HTTP de resend.com) o "smtp" (cualquier servidor SMTP: Gmail, Office 365, Zoho, etc.).
EMAIL_PROVIDER=log
# Remitente. Con Resend, el dominio tiene que estar verificado en su panel.
EMAIL_FROM=Corralap <ventas@tu-dominio.com>
# Opcional: a dónde llegan las respuestas del cliente (ej. la casilla del corralón).
EMAIL_REPLY_TO=
# Nombre que se muestra arriba del correo (en mayúsculas).
EMAIL_BRAND_NAME=Corralap
# Resend (EMAIL_PROVIDER=resend): clave de API "re_..."
RESEND_API_KEY=
# SMTP (EMAIL_PROVIDER=smtp): 587 usa STARTTLS, 465 usa SSL directo.
# Con Gmail hace falta una "contraseña de aplicación" (no la contraseña normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# WhatsApp Cloud API (Meta): chat real dentro del CRM
# ------------------------------------------------------------------------------
# Sin WHATSAPP_TOKEN y WHATSAPP_PHONE_NUMBER_ID, el botón WhatsApp abre wa.me y registra el contacto.
# Token de acceso (ideal: token permanente de un usuario del sistema del Business Manager).
WHATSAPP_TOKEN=
# "Identificador del número de teléfono" (WhatsApp > Configuración de la API en developers.facebook.com).
WHATSAPP_PHONE_NUMBER_ID=
# Texto libre que inventás vos y cargás también en Meta al configurar el webhook
# (URL del webhook: https://<tu-dominio>/api/whatsapp/webhook, suscribir el campo "messages").
WHATSAPP_VERIFY_TOKEN=
# "Clave secreta de la app" (Configuración de la app > Básica). Valida la firma de cada aviso de Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Opcional: plantilla aprobada para escribir cuando pasaron más de 24 h del último mensaje del cliente.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es_AR
# Prefijo de país que se asume cuando el celular está cargado sin él (54 = Argentina).
WHATSAPP_DEFAULT_COUNTRY_CODE=54

# ------------------------------------------------------------------------------
# Asistente con IA: borradores de respuesta y «Ponete al día» con el cliente
# ------------------------------------------------------------------------------
# Sin clave funciona en modo simulado (plantillas, sin costo). Clave en console.anthropic.com.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high: cuánto razona el modelo. "low" alcanza para borradores y preguntas cortas.
AI_EFFORT=low
# Tope de gasto mensual en dólares para todo el CRM (al llegar, el asistente se apaga hasta el mes siguiente).
AI_MONTHLY_BUDGET_USD=10
# Precio por millón de tokens del modelo elegido (para calcular el gasto). Opus 5.5: 4 / 20.
AI_PRICE_INPUT_PER_MTOK=4
AI_PRICE_OUTPUT_PER_MTOK=20
AI_DAILY_REQUESTS_PER_USER=60

# ------------------------------------------------------------------------------
# Gmail del vendedor (enviar desde su casilla y recibir las respuestas en el CRM)
# ------------------------------------------------------------------------------
# Google Cloud > APIs y servicios: habilitar la API de Gmail, pantalla de consentimiento (modo prueba con
# los vendedores como usuarios de prueba) y credencial "ID de cliente de OAuth" de tipo Aplicación web.
# URI de redirección autorizada = GOOGLE_REDIRECT_URI. Sin GOOGLE_CLIENT_ID el correo sale por EMAIL_PROVIDER.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
# A dónde vuelve el navegador después de conectar la cuenta (la app Next.js).
FRONTEND_URL=http://localhost:3000
# Clave Fernet para cifrar los tokens de Google (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
TOKEN_ENCRYPTION_KEY=
# Secreto que manda Vercel Cron para sincronizar respuestas (/api/gmail/cron).
CRON_SECRET=
